{
  "uid": "postgresql",
  "title": "PostgreSQL",
  "description": "Health, load and size of the shared PostgreSQL, per database",
  "tags": [
    "lab",
    "data"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up, cluster)",
          "refId": "PromVar"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "app",
        "label": "Postgres cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(cnpg_collector_up{cluster=~\"$cluster\"}, app)",
          "refId": "PromVar"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {}
      },
      {
        "name": "datname",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(cnpg_pg_database_size_bytes{cluster=~\"$cluster\", app=~\"$app\"}, datname)",
          "refId": "PromVar"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "lab"
      ],
      "title": "Lab dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**Shared PostgreSQL** (CloudNativePG). Each app has its own database: pick it in *Database*. Connections near the limit, a full volume, deadlocks and long transactions are what usually hurt apps."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      }
    },
    {
      "type": "row",
      "title": "Is it healthy?",
      "collapsed": false,
      "panels": [],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Up",
      "description": "1 = every instance answers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(cnpg_collector_up{cluster=~\"$cluster\", app=~\"$app\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Instances ready",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_ready{condition=\"true\", cluster=~\"$cluster\", pod=~\"$app-[0-9]+\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 3,
        "y": 3,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Connections used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(cnpg_backends_total{cluster=~\"$cluster\", app=~\"$app\"}) / max(cnpg_pg_settings_setting{name=\"max_connections\", cluster=~\"$cluster\", app=~\"$app\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.6
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Transactions/s",
      "description": "",
