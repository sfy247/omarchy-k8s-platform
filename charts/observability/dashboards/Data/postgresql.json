        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(cnpg_pg_stat_database_xact_commit{cluster=~\"$cluster\", app=~\"$app\", datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} commit",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(cnpg_pg_stat_database_xact_rollback{cluster=~\"$cluster\", app=~\"$app\", datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} rollback",
          "refId": "B"
