        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 8,
      "gridPos": {
        "x": 15,
        "y": 3,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
