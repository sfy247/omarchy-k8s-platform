        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(cnpg_pg_stat_database_xact_commit{cluster=~\"$cluster\", app=~\"$app\", datname=~\"$datname\"}[5m]) + rate(cnpg_pg_stat_database_xact_rollback{cluster=~\"$cluster\", app=~\"$app\", datname=~\"$datname\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 6,
      "gridPos": {
        "x": 9,
        "y": 3,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Reads served from memory. Below ~99% the working set doesn't fit in shared_buffers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(cnpg_pg_stat_database_blks_hit{cluster=~\"$cluster\", app=~\"$app\", datname=~\"$datname\"}[5m])) / (sum(rate(cnpg_pg_stat_database_blks_hit{cluster=~\"$cluster\", app=~\"$app\", datname=~\"$datname\"}[5m])) + sum(rate(cnpg_pg_stat_database_blks_read{cluster=~\"$cluster\", app=~\"$app\", datname=~\"$datname\"}[5m])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 3,
        "h": 4
      }
    },
