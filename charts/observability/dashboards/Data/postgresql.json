          "expr": "sum(cnpg_pg_database_size_bytes{cluster=~\"$cluster\", app=~\"$app\"}) / sum(kube_persistentvolumeclaim_resource_requests_storage_bytes{cluster=~\"$cluster\", persistentvolumeclaim=~\"$app-[0-9]+\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
