        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (cluster) (up{job=\"integrations/alloy\", cluster=~\"$cluster\"}))",
