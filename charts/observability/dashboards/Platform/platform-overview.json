        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_status_waiting{cluster=~\"$cluster\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
