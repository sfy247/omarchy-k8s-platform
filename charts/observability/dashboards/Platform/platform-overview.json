    {
      "type": "timeseries",
      "title": "Telemetry pipeline (per cluster)",
      "description": "Metrics each cluster's Alloy pushes to the hub. Failures here mean data is missing everywhere else.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (cluster) (rate(prometheus_remote_storage_samples_total{job=\"integrations/alloy\", cluster=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}} samples/s sent",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (cluster) (rate(prometheus_remote_storage_samples_failed_total{job=\"integrations/alloy\", cluster=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}} samples/s failed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
